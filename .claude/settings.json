{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(npm view *)",
      "Bash(npx biome *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "mcp__mcp-testing"
    ],
    "deny": ["Bash(git push*)", "Bash(rm -rf *)", "Read(./.env)", "Read(./.env.*)"]
  },
  "enabledMcpjsonServers": ["mcp-testing"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
            "timeout": 30,
            "statusMessage": "Biome formatiert …"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.mjs\"",
            "timeout": 120,
            "statusMessage": "Typecheck …"
          }
        ]
      }
    ]
  }
}
